# ---------- dev stage (used by docker compose for local dev) ----------
FROM node:20-alpine AS dev
WORKDIR /app
# Install deps in a separate layer so they survive source-only rebuilds.
# node_modules lives in a named volume so the host filesystem never shadows it.
COPY package*.json ./
RUN npm ci
EXPOSE 5173
CMD ["npm", "run", "dev"]

# ---------- build stage (produces dist/) ----------
FROM dev AS build
COPY . .
RUN npm run build

# ---------- preview stage (serve the built site locally to verify it) ----------
FROM nginx:1.27-alpine AS preview
COPY --from=build /app/dist /usr/share/nginx/html/pool-lanes
# nginx must serve the site under /pool-lanes/ to match the Vite base path
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
